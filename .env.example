# =============================================================================
# AssistOS — variaveis de ambiente
# =============================================================================
# Copie este arquivo para `.env.local` e preencha com as credenciais do seu
# projeto Supabase (Project Settings > API).
#
#   cp .env.example .env.local        (Linux / macOS)
#   copy .env.example .env.local      (Windows CMD)
#
# `.env.local` esta no .gitignore e NUNCA deve ser comitado.
# =============================================================================

# URL do projeto Supabase. Publica — pode ir para o bundle do browser.
NEXT_PUBLIC_SUPABASE_URL=

# Chave anonima (anon/public). Publica — protegida por Row Level Security.
# Aceita a chave legada (anon, JWT) ou a nova publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# ATENCAO
# -----------------------------------------------------------------------------
# A `service_role key` do Supabase NAO deve ser adicionada aqui nem usada no
# codigo da aplicacao. Ela ignora todas as politicas de RLS. Caso venha a ser
# necessaria (scripts administrativos, jobs), ela deve viver apenas como
# variavel de ambiente do servidor, sem o prefixo NEXT_PUBLIC_, e nunca ser
# importada em componentes de cliente.
# -----------------------------------------------------------------------------

# URL publica da aplicacao (usada em redirects de autenticacao).
# Local: http://localhost:3000 | Producao: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
